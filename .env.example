# Swasthya Setu Environment Configuration Template
SECRET_KEY=your_cryptographically_secure_flask_secret_key_here
FERNET_KEY=your_32_byte_base64_fernet_encryption_key_here
DATABASE_URL=sqlite:///swasthya_setu.db
MIN_GROUP_SIZE=5
DOCTOR_RECORD_EDIT_WINDOW_HOURS=24
PORT=5000
FLASK_ENV=production
DEBUG=False
DEMO_MODE=False

# SMTP Configuration (TLS / SSL)
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=your_smtp_username@example.com
MAIL_PASSWORD=your_smtp_app_password_here
MAIL_DEFAULT_SENDER="Swasthya Setu Health Authority <no-reply@swasthyasetu.org>"

# Optional External API Integrations
GEMINI_API_KEY=your_gemini_api_key_here
AI_API_KEY=your_gemini_api_key_here
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=your_brevo_sender@example.com
OTP_PROVIDER_API_KEY=your_sms_gateway_api_key_here
